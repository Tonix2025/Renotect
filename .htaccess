# Send renotect.ca and http:// to https://www.renotect.ca (one version of the site for Google)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^renotect\.ca$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.renotect.ca/$1 [R=301,L]

# Build scripts in the repo are not part of the website
RedirectMatch 404 ^/tools/

# Images, CSS and JS are cached for a year (CSS/JS links carry ?v= so changes still show).
# HTML is always re-checked so updates appear right away.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
