{"@type":"Service","name":"Bathroom renovation and design","serviceType":"Bathroom renovation","provider":{"@id":"https://www.renotect.ca/#business"},"areaServed":[{"@type":"City","name":"Toronto"},{"@type":"Place","name":"North York"},{"@type":"Place","name":"Etobicoke"},{"@type":"City","name":"Vaughan"},{"@type":"City","name":"Richmond Hill"},{"@type":"Place","name":"Greater Toronto Area"}],"url":"https://www.renotect.ca/services/bathroom-renovation-toronto/"},
{"@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"Does a bathroom renovation need a permit in Toronto?","acceptedAnswer":{"@type":"Answer","text":"Replacing fixtures and finishes in the same places usually does not. Adding a bathroom, moving drains or changing the structure usually does. We check this at the start and prepare the permit drawings if they are needed."}},
{"@type":"Question","name":"Can you move the shower or toilet to a new spot?","acceptedAnswer":{"@type":"Answer","text":"Often, yes. It depends on where the drains and the vent can go and what is below the floor. We check this at the consultation before the layout is drawn."}},
{"@type":"Question","name":"Can you design a custom vanity?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our vanities are designed to fit the room, with cabinetry, finishes, mirrors and lighting planned together."}},
{"@type":"Question","name":"How much does a bathroom renovation cost?","acceptedAnswer":{"@type":"Answer","text":"It depends on the size of the room, the finishes and how much changes behind the walls. We explain the scope and the cost after the free consultation, before any work starts."}},
{"@type":"Question","name":"Do you renovate bathrooms as part of a larger project?","acceptedAnswer":{"@type":"Answer","text":"Yes. Many of our bathrooms are part of a full-home renovation or a new custom home."}},
{"@type":"Question","name":"Which areas do you serve?","acceptedAnswer":{"@type":"Answer","text":"Toronto, including North York and Etobicoke, Vaughan, Richmond Hill and the rest of the Greater Toronto Area."}}]}
